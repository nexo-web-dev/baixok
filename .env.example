# Configuracao do Baixo K.
# Copie para `.env` e ajuste. O `.env` nunca vai para o Git.
#
# Toda variavel abaixo e validada na subida do servidor (backend/src/config/env.js).
# Valor escrito errado derruba o processo com a mensagem do que corrigir, em vez
# de cair no padrao em silencio.

# ---------------------------------------------------------------- ambiente ---
NODE_ENV=production
PORT=8000

# Pasta de arquivos locais (uploads). Fica FORA da arvore servida pela web de
# proposito. O banco NAO mora mais aqui — veja SUPABASE_DATABASE_URL abaixo.
# DATA_DIR=./data

# ------------------------------------------------------------------ banco ---
# OBRIGATORIA. E o unico banco do sistema; sem ela o backend nao sobe.
#
# Onde achar: painel do Supabase -> botao "Connect" no topo -> aba
# "Connection string" -> escolha "Session pooler".
#
# Por que o Session pooler e nao "Direct connection": a conexao direta do
# Supabase so atende por IPv6, e a maioria dos hosts nao tem.
#
# Por que a porta 5432 (session) e nao a 6543 (transaction): o backend roda como
# processo longo e mantem um pool proprio. O modo transaction e para ambiente
# serverless, onde cada chamada abre e fecha a conexao.
#
# Carrega a SENHA do banco: nunca vai para o Git, nunca para o front, nunca
# colada em conversa. No host, cadastre como variavel de ambiente.
SUPABASE_DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-1-REGIAO.pooler.supabase.com:5432/postgres

# Somente para bancos que exigem certificado de cliente (mTLS), como o
# PostgreSQL da Square Cloud. Baixe o certificate.pem no painel do banco e
# converta o arquivo inteiro para Base64; nunca cole ou versione o PEM aqui.
# DATABASE_CLIENT_CERT_BASE64=

# Endereco publico da API do Supabase. Coisa DIFERENTE da linha acima.
# Usado so pelo Auth; sem ele o login cai no banco local de usuarios.
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ sessao ---
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------- seguranca --
# Ligue as DUAS abaixo somente com um proxy TLS (nginx, Caddy, Cloudflare) na
# frente. Sem proxy, TRUST_PROXY=1 e um furo: quem chama direto forja
# X-Forwarded-For e escapa de todos os limites por IP.
TRUST_PROXY=0
COOKIE_SECURE=0

# So para desenvolvimento, quando o Vite roda em outra porta.
# Em producao o front sai do proprio backend e isto fica vazio.
# CORS_ORIGIN=http://localhost:5173

# Tetos por IP. Solte se a loja tem wifi unico e muitos clientes saem pelo
# mesmo IP; aperte se o sistema esta exposto na internet.
LIMITE_LOGIN=30
LIMITE_PEDIDO=60
LIMITE_GEOCODIFICACAO=120
LIMITE_GERAL=3000

# ----------------------------------------------------------------- Mapbox ---
# Opcional. Sem token, a entrega funciona com endereco digitado livremente e
# sem taxa automatica.
#
# Token "pk." (publico) tambem vai para o navegador, para montar o widget de
# busca. Token "sk." (secreto) NUNCA sai do servidor: nesse caso o widget nao
# aparece e a busca passa pelo backend, que continua funcionando igual.
# MAPBOX_TOKEN=pk.xxxxxxxx
# MAPBOX_API=https://api.mapbox.com

# ------------------------------------------------- primeiro administrador ---
# Usados so pelo `npm run seed`, na primeira instalacao.
# Sem ADMIN_BOOTSTRAP_PASSWORD o seed sorteia uma senha e mostra no terminal.
ADMIN_BOOTSTRAP_USER=admin
# ADMIN_BOOTSTRAP_PASSWORD=troque-esta-senha-agora
# BALCAO_BOOTSTRAP_PASSWORD=troque-esta-senha-agora

# --------------------------------------------------------------------- log ---
LOG_LEVEL=info
